{
  "$schema": "https://schema.railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "SMS.API/Dockerfile"
  },
  "deploy": {
    "startCommand": "dotnet SMS.API.dll",
    "healthcheckPath": "/swagger/v1/swagger.json",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
